---
import ArticleHeading from '../../components/ArticleHeading.astro'
import ContactCta from '../../components/ContactCta.astro'
import CookieConsent from '../../components/CookieConsent.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import KnowledgeTree from '../../components/KnowledgeTree.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getArticleById, getCategoryById, getChildArticles, knowledgeArticles } from '../../data/knowledge'

export function getStaticPaths() {
  return knowledgeArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }))
}

const { article } = Astro.props
const category = getCategoryById(article.categoryId)
const parent = article.parentId ? getArticleById(article.parentId) : undefined
const childArticles = getChildArticles(article.id)
const relatedArticles = article.relatedIds.flatMap((id: string) => {
  const related = getArticleById(id)
  return related ? [related] : []
})
const nextArticles = article.nextIds.flatMap((id: string) => {
  const next = getArticleById(id)
  return next ? [next] : []
})

const headingIds = new Set(['child-articles-title', 'contact'])

function headingId(title: string): string {
  const slug = title.normalize('NFKC').toLocaleLowerCase('ru-RU')
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-|-$/g, '') || 'section'
  let id = slug
  let suffix = 2

  while (headingIds.has(id)) {
    id = `${slug}-${suffix++}`
  }

  headingIds.add(id)
  return id
}
---

<BaseLayout title={`${article.title} | Вики Егора Жолнина`} description={article.summary} canonicalPath={`/articles/${article.slug}`} article>
  <Header />
  <main class="shell article-shell">
    <details class="mobile-tree" data-testid="mobile-tree">
      <summary>Разделы вики</summary>
      <KnowledgeTree activeSlug={article.slug} />
    </details>
    <aside class="article-aside">
      <KnowledgeTree activeSlug={article.slug} />
    </aside>
    <article class="article-content">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Вики</a><span>/</span><a href={`/#${article.categoryId}`}>{category.title}</a><span>/</span>
        {parent && <><a href={`/articles/${parent.slug}`}>{parent.title}</a><span>/</span></>}
        <span aria-current="page">{article.title}</span>
      </nav>
      <header class="article-header">
        <p class="eyebrow">{category.title}</p>
        <ArticleHeading level={1} id={headingId(article.title)}>{article.title}</ArticleHeading>
        <p class="article-summary">{article.summary}</p>
        <p class="article-updated">Инструкция проверена: {new Intl.DateTimeFormat('ru-RU', { dateStyle: 'long' }).format(new Date(`${article.updatedAt}T12:00:00Z`))}</p>
      </header>

      <div class="article-body">
        <p class="article-intro">{article.intro}</p>
        {childArticles.length > 0 && (
          <section aria-labelledby="child-articles-title">
            <ArticleHeading id="child-articles-title">Инструкции по CRM</ArticleHeading>
            <div class="linked-articles">
              {childArticles.map((item) => <a class="linked-article" href={`/articles/${item.slug}`}>{item.title}<span>{item.summary}</span></a>)}
            </div>
          </section>
        )}
        {article.sections.map((section) => (
          <section>
            <ArticleHeading id={headingId(section.heading)}>{section.heading}</ArticleHeading>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
            {section.records && (
              <dl class="article-records">
                {section.records.map((record) => <div><dt>{record.label}</dt><dd>{record.value}</dd></div>)}
              </dl>
            )}
          </section>
        ))}

        {article.warning && (
          <aside class="warning">
            <ArticleHeading id={headingId('Важно')}>Важно</ArticleHeading>
            <p>{article.warning}</p>
          </aside>
        )}

        {article.sources && (
          <div class="article-source">
            {article.sources.length === 1 ? (
              <p>Источник: <a href={article.sources[0].url} target="_blank" rel="noreferrer">{article.sources[0].label}</a></p>
            ) : (
              <>
                <ArticleHeading id={headingId('Источники')}>Источники</ArticleHeading>
                <ul>{article.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul>
              </>
            )}
          </div>
        )}
      </div>

      {(relatedArticles.length > 0 || nextArticles.length > 0) && (
        <section class="article-links" aria-label="Продолжить чтение">
          {nextArticles.length > 0 && (
            <div>
              <ArticleHeading id={headingId('Следующий шаг')} class="eyebrow">Следующий шаг</ArticleHeading>
              {nextArticles.map((item) => <a class="linked-article primary" href={`/articles/${item.slug}`}>{item.title}<span>{item.summary}</span></a>)}
            </div>
          )}
          {relatedArticles.length > 0 && (
            <div>
              <ArticleHeading id={headingId('Связанные темы')} class="eyebrow">Связанные темы</ArticleHeading>
              <div class="linked-articles">{relatedArticles.map((item) => <a class="linked-article" href={`/articles/${item.slug}`}>{item.title}<span>{item.summary}</span></a>)}</div>
            </div>
          )}
        </section>
      )}

      <ContactCta articleTitle={article.title} />
    </article>
  </main>
  <Footer />
  <CookieConsent />
</BaseLayout>
