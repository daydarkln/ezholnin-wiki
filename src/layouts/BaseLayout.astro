---
import '../styles/global.css'

type Props = {
  title: string
  description: string
  canonicalPath?: string
  article?: boolean
}

const { title, description, canonicalPath = '/', article = false } = Astro.props
const siteUrl = new URL(canonicalPath, Astro.site).toString()
const ogImage = new URL('/og-wiki.svg', Astro.site).toString()
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      mainEntityOfPage: siteUrl,
      inLanguage: 'ru-RU',
      author: { '@type': 'Person', name: 'Егор Жолнин', url: 'https://ezholnin.ru' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Вики — Егор Жолнин',
      description,
      url: siteUrl,
      inLanguage: 'ru-RU',
      publisher: { '@type': 'Person', name: 'Егор Жолнин', url: 'https://ezholnin.ru' },
    }
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Вики — Егор Жолнин" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Вики о разработке лендинга — Егор Жолнин" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <slot />
  </body>
</html>
